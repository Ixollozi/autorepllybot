# Telegram
BOT_TOKEN=
OWNER_CHAT_ID=

# CRM (https://crm.neosamptech.uz) — или задайте в боте /crm_url + /crm_key
CRM_BASE_URL=https://crm.neosamptech.uz
AUTOREPLY_API_KEY=
MINIAPP_URL=https://crm.neosamptech.uz/mini_app

# Optional local LLM fallback (если CRM ещё без API / ключ не задан)
GROQ_API_KEY=
GROQ_API_KEYS=
GEMINI_API_KEY=
GEMINI_API_KEYS=

# STT (Groq whisper-large-v3 primary via CRM keys; local = fallback)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# App
DATABASE_URL=sqlite+aiosqlite:///./data/autoreply.db
LOG_LEVEL=INFO
TZ=Asia/Tashkent
